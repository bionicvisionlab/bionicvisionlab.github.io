      &lt;a href=&#34;https://bionicvisionlab.org/img/gallery/001%20At%20Fall%20Vision%20Meeting%20with%20Dan%20Adams%20Eduardo%20Fernandez%20Xing%20Chen%20Frederik%20Ceyssens%20Antonio%20Lozano%20Jan%20Antolik.jpg&#34; itemprop=&#34;contentUrl&#34; aria-label=&#34;View larger: At the Fall Vision Meeting with Dan Adams, Eduardo Fernandez, Xing Chen, Frederik Ceyssens, Antonio Lozano, and Jan Antolik.&#34;&gt;&lt;/a&gt;
      &lt;figcaption&gt;&lt;p&gt;At the Fall Vision Meeting with Dan Adams, Eduardo Fernandez, Xing Chen, Frederik Ceyssens, Antonio Lozano, and Jan Antolik.&lt;/p&gt;&lt;/figcaption&gt;
